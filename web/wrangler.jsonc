{
  "$schema": "./node_modules/wrangler/config-schema.json",
  "name": "net-regime-monitor",
  "compatibility_date": "2026-10-07",
  "assets": {
    "directory": "./dist",
    "not_found_handling": "404-page"
  },
  "routes": [{ "pattern": "net-regime-monitor.therephrase.com/*", "zone_name": "therephrase.com" }]
}
