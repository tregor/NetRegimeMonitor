{
  "manifest_version": 3,
  "name": "Net Regime Monitor",
  "version": "1.0.0",
  "description": "Фоновая проверка доступности российских, нейтральных и ограниченных сайтов.",
  "permissions": [
    "alarms",
    "storage",
    "notifications"
  ],
  "host_permissions": [
    "https://ya.ru/*",
    "https://yandex.ru/*",
    "https://vk.com/*",
    "https://www.gosuslugi.ru/*",
    "https://mail.ru/*",
    "https://lenta.ru/*",
    "https://habr.com/*",
    "https://example.com/*",
    "https://www.cloudflare.com/*",
    "https://www.wikipedia.org/*",
    "https://www.google.com/*",
    "https://1.1.1.1/*",
    "https://github.com/*",
    "https://www.instagram.com/*",
    "https://www.facebook.com/*",
    "https://x.com/*",
    "https://www.youtube.com/*",
    "https://discord.com/*",
    "https://telegram.org/*"
  ],
  "background": {
    "service_worker": "background.js",
    "type": "module"
  },
  "action": {
    "default_title": "Net Regime Monitor",
    "default_popup": "popup.html"
  },
  "icons": {
    "128": "icons/icon128.png"
  }
}