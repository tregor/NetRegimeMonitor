{
  "manifest_version": 3,
  "name": "Net Regime Monitor",
  "version": "1.0.0",
  "description": "Фоновая проверка доступности российских, нейтральных и ограниченных сайтов.",
  "permissions": [
    "alarms",
    "storage",
    "notifications"
  ],
  "host_permissions": [
    "https://*/*"
  ],
  "background": {
    "service_worker": "background.js",
    "type": "module"
  },
  "action": {
    "default_title": "Net Regime Monitor",
    "default_popup": "popup.html"
  },
  "icons": {
    "128": "icons/icon128.png"
  }
}